{
  "name": "hand-chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MediaPipeのハンドトラッキングだけで指すブラウザチェス (Cloudflare Workers + Durable Objects)",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.0",
    "@cloudflare/workers-types": "^5.20260925.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kawamoto24e1058/hand-chess.git"
  },
  "homepage": "https://github.com/Kawamoto24e1058/hand-chess",
  "license": "MIT"
}
