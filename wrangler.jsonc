{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hand-chess",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hand-chess", "database_id": "8fb080be-4a43-4340-8dc7-5dd431dad61f", "migrations_dir": "migrations" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }
  ]
}
